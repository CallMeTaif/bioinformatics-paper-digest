---
import Base from '../../layouts/Base.astro';
import ReadingStatus from '../../components/ReadingStatus.astro';
import { allPapers, getPaper, SUMMARY_SECTIONS, accentVar, formatDate, readingMinutes, tagLabel } from '../../lib/papers';

export function getStaticPaths() {
  return allPapers().map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const paper = getPaper(slug!);
if (!paper) return Astro.redirect('/404');

const tag = paper.subfield_tags?.[0] ?? 'bioinformatics';
const authEnabled = Boolean(import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY);
// We only host a copy when the licence permits redistribution; otherwise we link out.
const hostedPdf = paper.hosted_pdf_path;
const originalLink = paper.original_url ?? paper.pdf_original_url;

// Lightweight share links (no third-party scripts/tracking).
const shareUrl = new URL(`/paper/${paper.slug}/`, Astro.site ?? 'https://www.bioread.bio').href;
const u = encodeURIComponent(shareUrl);
const tx = encodeURIComponent(paper.title);
const shareX = `https://twitter.com/intent/tweet?text=${tx}&url=${u}`;
const shareLinkedIn = `https://www.linkedin.com/sharing/share-offsite/?url=${u}`;
const shareWhatsApp = `https://api.whatsapp.com/send?text=${encodeURIComponent(paper.title + ' ' + shareUrl)}`;
---
<Base title={`${paper.title} — BioRead`} description={paper.summary.tldr}>
  <div id="progress"></div>

  <div class="detail">
    <article>
      <div class="chips" style="margin-bottom:12px;">
        <span class="chip tag" style={`--chip-accent:${accentVar(paper.tag_accent)}`}>{tagLabel(tag)}</span>
        <span class="chip diff">{paper.difficulty_level}</span>
      </div>

      <h1>{paper.title}</h1>
      <div class="byline">{(paper.authors ?? []).join(', ')}</div>
      <div class="byline">{paper.venue} · {formatDate(paper.publication_date)} · {readingMinutes(paper)} min read</div>

      <div class="summary">
        {SUMMARY_SECTIONS.map((s) => (
          <section class={s.key}>
            <h2>{s.label}</h2>
            <p>{paper.summary[s.key]}</p>
          </section>
        ))}
      </div>

      {hostedPdf && (
        <section class="pdf-section">
          <h2 class="pdf-head">Full paper</h2>
          <object class="pdf-frame" data={hostedPdf} type="application/pdf">
            <p>Your browser can’t display PDFs inline. <a href={hostedPdf}>Download the PDF</a> instead.</p>
          </object>
        </section>
      )}
    </article>

    <aside class="sidebar">
      {authEnabled && (
        <div class="reading-box">
          <span class="reading-label">My reading</span>
          <ReadingStatus slug={paper.slug} />
        </div>
      )}

      <div class="info-panel">
        <dl>
          <dt>Venue</dt><dd>{paper.venue ?? '—'}</dd>
          <dt>Published</dt><dd>{formatDate(paper.publication_date) || '—'}</dd>
          {paper.doi && (<><dt>DOI</dt><dd><a href={`https://doi.org/${paper.doi}`}>{paper.doi}</a></dd></>)}
          <dt>License</dt><dd>{paper.license}</dd>
          <dt>Open access</dt><dd>{paper.oa_status ?? '—'}</dd>
          <dt>Source</dt><dd>{paper.source}</dd>
          {paper.is_preprint && (<><dt>Peer review</dt><dd>preprint — not reviewed</dd></>)}
          <dt>Summarized from</dt><dd>{paper.used_full_text ? 'full text' : 'abstract'}</dd>
        </dl>
        {originalLink && <a class="btn" href={originalLink} target="_blank" rel="noopener">Read the original ↗</a>}
        {hostedPdf && <a class="btn btn-secondary" href={hostedPdf} download>Download PDF ↓</a>}
      </div>

      <div class="share">
        <span class="share-label">Share</span>
        <div class="share-row">
          <button type="button" class="share-btn" id="copy-link" data-url={shareUrl} aria-label="Copy link" title="Copy link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
          <a class="share-btn" href={shareX} target="_blank" rel="noopener" aria-label="Share on X" title="Share on X">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a class="share-btn" href={shareLinkedIn} target="_blank" rel="noopener" aria-label="Share on LinkedIn" title="Share on LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a class="share-btn" href={shareWhatsApp} target="_blank" rel="noopener" aria-label="Share on WhatsApp" title="Share on WhatsApp">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.372-.025-.521-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          </a>
        </div>
      </div>
    </aside>
  </div>

  <script is:inline>
    const bar = document.getElementById('progress');
    const onScroll = () => {
      const h = document.documentElement;
      const pct = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100;
      if (bar) bar.style.width = pct + '%';
    };
    document.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Copy-link button
    const copyBtn = document.getElementById('copy-link');
    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.url);
        copyBtn.classList.add('copied');
        const t = copyBtn.getAttribute('title');
        copyBtn.setAttribute('title', 'Copied!');
        setTimeout(() => { copyBtn.classList.remove('copied'); copyBtn.setAttribute('title', t); }, 1500);
      } catch (e) { /* clipboard blocked — no-op */ }
    });
  </script>
</Base>
