---
import Base from '../layouts/Base.astro';
import { allPapers, tagLabel, sourceLabel } from '../lib/papers';
import stats from '../data/run-stats.json';

// Library snapshot (built at deploy time from the published set).
const papers = allPapers();
const total = papers.length;
const countBy = (fn: (p: any) => string) => {
  const m: Record<string, number> = {};
  for (const p of papers) { const k = fn(p); m[k] = (m[k] || 0) + 1; }
  return Object.entries(m).sort((a, b) => b[1] - a[1]);
};
const byTopic = countBy((p) => tagLabel(p.subfield_tags?.[0] ?? 'bioinformatics'));
const bySource = countBy((p) => sourceLabel(p.source));

// Rough spend estimate — we don't read real provider balances (that needs secret
// keys), so this is an approximation from a per-paper average, clearly labelled.
const EST_PER_PAPER = 0.19;
const estTotal = (total * EST_PER_PAPER).toFixed(2);
const estRun = ((stats.published ?? 0) * EST_PER_PAPER).toFixed(2);

const s: any = stats;
const funnelMax = Math.max(1, s.discovered || 1);
const funnel = [
  { label: 'Discovered', value: s.discovered },
  { label: 'New (after dedup)', value: s.new_candidates },
  { label: 'Pre-screen kept', value: s.prescreen_kept ?? '—' },
  { label: 'Summarizable', value: s.summarizable },
  { label: 'Published', value: s.published },
  { label: 'Flagged', value: s.flagged },
];
---
<Base title="Control Room — BioRead" description="Private pipeline dashboard.">
  <p id="gate" class="empty">Checking access…</p>

  <div id="dash" hidden>
    <section class="hero" style="padding:36px 0 8px;">
      <h1>Control Room</h1>
      <p style="color:var(--muted);margin:0;">Private pipeline dashboard — visible only to you.</p>
    </section>
    <div class="basepair-divider" role="presentation"></div>

    <!-- top tiles -->
    <div class="tiles">
      <div class="tile"><span class="t-label">Papers live</span><span class="t-val">{total}</span></div>
      <div class="tile"><span class="t-label">Next run</span><span class="t-val" id="next-run">—</span><span class="t-sub" id="next-run-rel"></span></div>
      <div class="tile"><span class="t-label">Last run published</span><span class="t-val">{s.published ?? 0}<span class="t-unit">/ target {s.target ?? 1}</span></span><span class="t-sub">{s.flagged ?? 0} flagged</span></div>
      <div class="tile"><span class="t-label">Est. spend (rough)</span><span class="t-val">${estRun}</span><span class="t-sub">~${estTotal} all-time</span></div>
    </div>

    <!-- last run -->
    <h2 class="sec">Last run</h2>
    <p class="run-meta" id="run-meta">
      {s.ran_at ? `${s.ran_at.replace('T', ' ').replace('+00:00', ' UTC')} · ${s.duration_s ?? '?'}s` : 'No run recorded yet — the next scheduled run will populate this.'}
    </p>
    <div class="funnel">
      {funnel.map((f) => (
        <div class="frow">
          <span class="fl">{f.label}</span>
          <span class="fbar"><span class="fbar-fill" style={`width:${typeof f.value === 'number' ? Math.round((f.value / funnelMax) * 100) : 0}%`}></span></span>
          <span class="fv">{f.value}</span>
        </div>
      ))}
    </div>

    <div class="models">
      <span><span class="m-label">Summarizer</span> {s.summarizer}</span>
      <span><span class="m-label">Verifier</span> {s.verifier}</span>
    </div>

    {s.papers && s.papers.length > 0 && (
      <>
        <h2 class="sec">Papers this run</h2>
        <table class="tbl">
          <thead><tr><th>Title</th><th>Topic</th><th>Status</th><th>Score</th></tr></thead>
          <tbody>
            {s.papers.map((p: any) => (
              <tr>
                <td class="td-title">{p.title}</td>
                <td>{p.topic ? tagLabel(p.topic) : '—'}</td>
                <td><span class={`st ${p.status}`}>{p.status}</span></td>
                <td class="td-num">{p.score ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )}

    {s.skipped && s.skipped.length > 0 && (
      <>
        <h2 class="sec">Skipped (failed to summarize)</h2>
        <ul class="skips">{s.skipped.map((x: any) => (<li>{x.title} <span class="reason">— {x.reason}</span></li>))}</ul>
      </>
    )}

    <!-- library breakdown -->
    <div class="cols2">
      <div>
        <h2 class="sec">By topic</h2>
        {byTopic.map(([k, v]) => (
          <div class="frow"><span class="fl">{k}</span><span class="fbar"><span class="fbar-fill" style={`width:${Math.round((v / Math.max(1, total)) * 100)}%`}></span></span><span class="fv">{v}</span></div>
        ))}
      </div>
      <div>
        <h2 class="sec">By source</h2>
        {bySource.map(([k, v]) => (
          <div class="frow"><span class="fl">{k}</span><span class="fbar"><span class="fbar-fill" style={`width:${Math.round((v / Math.max(1, total)) * 100)}%`}></span></span><span class="fv">{v}</span></div>
        ))}
      </div>
    </div>

    <p class="foot-note">Schedule: Mon / Wed / Fri · 08:00 UTC (GitHub may run it late). Spend is a rough per-paper estimate, not a live provider balance.</p>
  </div>

  <style>
    .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; padding: 10px 0 8px; }
    .tile { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; display: flex; flex-direction: column; gap: 4px; }
    .t-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
    .t-val { font-size: 1.7rem; font-weight: 650; line-height: 1.1; }
    .t-unit { font-size: 0.8rem; color: var(--muted); font-weight: 400; margin-left: 6px; }
    .t-sub { font-size: 0.78rem; color: var(--muted); font-family: var(--font-mono); }
    .sec { font-family: var(--font-ui); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--primary); margin: 28px 0 10px; }
    .run-meta { color: var(--muted); font-family: var(--font-mono); font-size: 0.85rem; margin: 0 0 12px; }
    .funnel { display: flex; flex-direction: column; gap: 8px; }
    .frow { display: grid; grid-template-columns: 160px 1fr 46px; align-items: center; gap: 12px; }
    .fl { font-size: 0.85rem; color: var(--text); }
    .fbar { height: 10px; background: color-mix(in srgb, var(--border) 60%, transparent); border-radius: 999px; overflow: hidden; }
    .fbar-fill { display: block; height: 100%; background: var(--primary); border-radius: 999px; }
    .fv { font-family: var(--font-mono); font-size: 0.85rem; text-align: right; color: var(--muted); }
    .models { display: flex; flex-wrap: wrap; gap: 20px; margin: 16px 0 4px; font-family: var(--font-mono); font-size: 0.82rem; color: var(--text); }
    .m-label { color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.7rem; margin-right: 6px; }
    .tbl { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    .tbl th { text-align: left; color: var(--muted); font-weight: 500; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 6px 10px; border-bottom: 1px solid var(--border); }
    .tbl td { padding: 8px 10px; border-bottom: 1px solid var(--border); vertical-align: top; }
    .td-title { max-width: 460px; }
    .td-num { font-family: var(--font-mono); }
    .st { font-size: 0.72rem; font-family: var(--font-mono); padding: 2px 8px; border-radius: 999px; border: 1px solid var(--border); }
    .st.published { color: var(--nt-a); border-color: var(--nt-a); }
    .st.flagged { color: var(--nt-g); border-color: var(--nt-g); }
    .skips { color: var(--muted); font-size: 0.88rem; padding-left: 18px; }
    .skips .reason { font-family: var(--font-mono); font-size: 0.8rem; }
    .cols2 { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
    .foot-note { color: var(--muted); font-size: 0.78rem; margin: 30px 0 70px; }
    @media (max-width: 720px) { .cols2 { grid-template-columns: 1fr; } .frow { grid-template-columns: 120px 1fr 40px; } }
  </style>

  <script>
    import { supabase } from '../lib/supabase';
    // Only this account may view the dashboard. Soft gate (client-side) — the data
    // shown is non-sensitive (counts/scores/model names), never keys or balances.
    const ADMIN = 'ai.taif.alharbi@gmail.com';

    (async () => {
      if (!supabase) { location.href = '/'; return; }
      const { data } = await supabase.auth.getSession();
      const email = data.session?.user?.email?.toLowerCase();
      if (!email) { location.href = '/login?next=/control'; return; }
      if (email !== ADMIN) { location.href = '/'; return; }
      document.getElementById('gate')!.hidden = true;
      document.getElementById('dash')!.hidden = false;
      renderNextRun();
    })();

    function renderNextRun() {
      const now = new Date();
      for (let i = 0; i < 14; i++) {
        const d = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() + i, 8, 0, 0));
        if ([1, 3, 5].includes(d.getUTCDay()) && d.getTime() > now.getTime()) {
          const el = document.getElementById('next-run')!;
          el.textContent = d.toLocaleString(undefined, { weekday: 'short', hour: '2-digit', minute: '2-digit' });
          const hrs = Math.round((d.getTime() - now.getTime()) / 3.6e6);
          document.getElementById('next-run-rel')!.textContent = hrs < 24 ? `in ~${hrs}h` : `in ~${Math.round(hrs / 24)}d`;
          return;
        }
      }
    }
  </script>
</Base>
