---
import Base from '../../layouts/Base.astro';
---
<Base title="Signing in… — BioRead" description="Completing sign-in.">
  <section class="auth-page">
    <h1 id="t">Signing you in…</h1>
    <p class="sub" id="m">One moment.</p>
    <p id="err" class="msg warn" hidden></p>
    <pre id="diag" hidden></pre>
    <p id="back" hidden><a href="/login">← Back to sign in</a></p>
  </section>

  <style>
    #diag {
      text-align: left; overflow: auto; font-size: 0.72rem; color: var(--muted);
      background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
      padding: 12px; margin-top: 14px; white-space: pre-wrap; word-break: break-all;
    }
  </style>

  <script>
    import { supabase } from '../../lib/supabase';
    const q = new URLSearchParams(location.search);
    const h = new URLSearchParams(location.hash.replace(/^#/, ''));
    const next = q.get('next') || '/my-library';
    const errorMsg =
      q.get('error_description') || q.get('error') ||
      h.get('error_description') || h.get('error');

    function fail(msg: string) {
      document.getElementById('t')!.textContent = 'Sign-in didn’t complete';
      document.getElementById('m')!.hidden = true;
      const e = document.getElementById('err')!; e.textContent = msg; e.hidden = false;
      document.getElementById('back')!.hidden = false;
      const d = document.getElementById('diag')!;
      d.textContent =
        `returned with token: ${location.hash.includes('access_token')}\n` +
        `url: ${location.href.replace(/(access_token=)[^&]+/, '$1<hidden>')}`;
      d.hidden = false;
    }

    (async () => {
      if (errorMsg) { fail(errorMsg); return; }
      if (!supabase) { fail('Sign-in isn’t configured.'); return; }
      try {
        // Maybe the auto-detector already established it…
        let { data: { session } } = await supabase.auth.getSession();
        // …otherwise set the session explicitly from the tokens in the URL hash.
        // This sidesteps Safari's timing quirk where the auto-detect event is missed.
        if (!session) {
          const access_token = h.get('access_token');
          const refresh_token = h.get('refresh_token');
          if (access_token && refresh_token) {
            const { data, error } = await supabase.auth.setSession({ access_token, refresh_token });
            if (error) throw error;
            session = data.session;
          }
        }
        if (session) { location.replace(next); return; }
        fail('No sign-in token was returned. Please try again.');
      } catch (e: any) {
        fail(`${e?.name || 'Error'}: ${e?.message || String(e)}`);
        const d = document.getElementById('diag')!;
        d.textContent += '\nstack: ' + String(e?.stack || '').split('\n').slice(0, 2).join(' | ');
      }
    })();
  </script>
</Base>
