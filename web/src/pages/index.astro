---
import Base from '../layouts/Base.astro';
import ReadingStatus from '../components/ReadingStatus.astro';
import { allPapers, tagLabel, accentVar, formatDate, readingMinutes } from '../lib/papers';

const papers = allPapers();
const lead = papers[0];
const side = papers.slice(1, 5);          // "Also this week"
const grid = papers.slice(5, 11);         // a curated handful; the rest live in the Library
const leadTag = lead ? tagLabel(lead.subfield_tags?.[0] ?? 'bioinformatics') : '';
---
<Base>
  <section class="hero">
    <h1>Bioinformatics, distilled.</h1>
    <p>
      Keep up with the field without drowning in PDFs. The strongest new open-access research —
      genomics, single-cell, proteomics, systems biology and beyond — each turned into a clear,
      few-minute read you can trust. Three new papers a week.
    </p>
    <div class="acgt-strip">A C G T · A T G C · G C A T · T A C G · A C G T</div>
  </section>

  <div class="basepair-divider" role="presentation"></div>

  {papers.length === 0 ? (
    <p style="color:var(--muted);padding:20px 0 80px;">The first summaries land soon — new papers publish Monday, Wednesday, and Friday. Check back shortly.</p>
  ) : (
    <>
      <div class="ed-lead">
        <article class="ed-feat">
          <div class="eyebrow">Latest</div>
          <a class="ed-feat-title" href={`/paper/${lead.slug}`}>{lead.title}</a>
          <p class="dek">{lead.summary.tldr}</p>
          <div class="meta">{lead.venue ?? 'Unknown venue'} · {formatDate(lead.publication_date)} · {readingMinutes(lead)} min read</div>
          <div class="ed-feat-foot">
            <span class="chip tag" style={`--chip-accent:${accentVar(lead.tag_accent)}`}>{leadTag}</span>
            <a class="ed-read" href={`/paper/${lead.slug}`}>Read →</a>
          </div>
        </article>

        {side.length > 0 && (
          <aside class="ed-side">
            <div class="ed-sh">Also this week</div>
            {side.map((p) => (
              <a class="ed-item" href={`/paper/${p.slug}`}>
                <span class="t">{p.title}</span>
                <span class="m">{p.venue ?? 'Unknown venue'} · {formatDate(p.publication_date)} · {readingMinutes(p)} min</span>
              </a>
            ))}
          </aside>
        )}
      </div>

      {grid.length > 0 && (
        <div class="ed-grid">
          {grid.map((p) => (
            <article class="ed-card" style={`--acc:${accentVar(p.tag_accent)}`}>
              <a class="t" href={`/paper/${p.slug}`}>{p.title}</a>
              <div class="m">{p.venue ?? 'Unknown venue'} · {formatDate(p.publication_date)} · {readingMinutes(p)} min</div>
              <p>{p.summary.tldr}</p>
              <ReadingStatus slug={p.slug} compact={true} />
            </article>
          ))}
        </div>
      )}

      <p class="all-link"><a href="/library">Browse the full library →</a></p>
    </>
  )}
</Base>
