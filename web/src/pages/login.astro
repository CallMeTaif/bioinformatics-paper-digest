---
import Base from '../layouts/Base.astro';
---
<Base title="Sign in — BioRead" description="Sign in to save papers to your reading list.">
  <section class="auth-page">
    <h1>Sign in</h1>
    <p class="sub">Save papers to read later, track what you're reading, and mark what you've finished.</p>

    <div class="auth-card">
      <button id="google" class="auth-btn google" type="button">
        <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"><path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.71-1.57 2.68-3.89 2.68-6.62z"/><path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.81.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z"/><path fill="#FBBC05" d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33z"/><path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58A9 9 0 0 0 .96 4.95L3.97 7.28C4.68 5.16 6.66 3.58 9 3.58z"/></svg>
        Continue with Google
      </button>

      <div class="or"><span>or</span></div>

      <form id="magic" class="magic">
        <label for="email">Email a magic link</label>
        <input id="email" type="email" required placeholder="you@example.com" autocomplete="email" />
        <button class="auth-btn primary" type="submit">Send link</button>
      </form>

      <p id="msg" class="msg" hidden></p>
      <p id="unconfigured" class="msg warn" hidden>Sign-in isn't configured yet.</p>
    </div>
  </section>

  <script>
    import { supabase } from '../lib/supabase';

    const params = new URLSearchParams(location.search);
    const next = params.get('next') || '/my-library';
    // Return through a dedicated callback that patiently completes the sign-in
    // (and surfaces any error) instead of racing on the destination page.
    const redirectTo = new URL('/auth/callback?next=' + encodeURIComponent(next), location.origin).href;

    const msg = document.getElementById('msg')!;
    const show = (t: string, warn = false) => { msg.textContent = t; msg.hidden = false; msg.classList.toggle('warn', warn); };

    if (!supabase) {
      document.getElementById('unconfigured')!.hidden = false;
      (document.getElementById('google') as HTMLButtonElement).disabled = true;
    } else {
      // Already signed in? Skip straight through.
      supabase.auth.getSession().then(({ data }) => { if (data.session) location.href = next; });

      document.getElementById('google')!.addEventListener('click', async () => {
        const { error } = await supabase!.auth.signInWithOAuth({ provider: 'google', options: { redirectTo } });
        if (error) show(error.message, true);
      });

      document.getElementById('magic')!.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = (document.getElementById('email') as HTMLInputElement).value.trim();
        if (!email) return;
        const { error } = await supabase!.auth.signInWithOtp({ email, options: { emailRedirectTo: redirectTo } });
        show(error ? error.message : `Check ${email} for your sign-in link.`, !!error);
      });
    }
  </script>
</Base>
