---
import type { Paper } from '../lib/papers';
import { accentVar, formatDate, readingMinutes, tagLabel } from '../lib/papers';
interface Props { paper: Paper; }
const { paper } = Astro.props;
const tag = paper.subfield_tags?.[0] ?? 'bioinformatics';
---
<article class="card">
  <div class="meta">{paper.venue ?? 'Unknown venue'} · {formatDate(paper.publication_date)} · {readingMinutes(paper)} min read</div>
  <a class="card-title" href={`/paper/${paper.slug}`}>{paper.title}</a>
  <p class="tldr">{paper.summary.tldr}</p>
  <div class="chips">
    <span class="chip tag" style={`--chip-accent:${accentVar(paper.tag_accent)}`}>{tagLabel(tag)}</span>
    <span class="chip diff">{paper.difficulty_level}</span>
  </div>
</article>
