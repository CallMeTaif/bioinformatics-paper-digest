---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'BioRead', description = 'AI-summarized, open-access bioinformatics research — verified and updated three times a week.' } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <!-- set theme before paint to avoid flash -->
    <script is:inline>
      const t = localStorage.getItem('theme');
      if (t) document.documentElement.setAttribute('data-theme', t);
    </script>
  </head>
  <body>
    <canvas id="net" class="site-net" aria-hidden="true"></canvas>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href="/">
          BioRead
        </a>
        <nav class="nav">
          <a href="/">Latest</a>
          <a href="/library">Library</a>
          <a href="/about">About</a>
          <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">◐</button>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        Short summaries to always keep up with the world of bioinformatics.
      </div>
    </footer>

    <script is:inline>
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const cur = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', cur);
        localStorage.setItem('theme', cur);
      });
    </script>

    <script is:inline>
      // Site-wide DNA double-helix background: a field of diagonally tilted,
      // slowly rotating helices — teal backbones with nucleotide-colored base
      // pairs. Fixed behind all content; theme-aware ink (deeper + boosted on
      // light grounds); a single static frame for reduced-motion.
      (() => {
        const canvas = document.getElementById('net');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const PALETTE = {
          dark:  { strand: ['#14B8A6', '#5EEAD4'], bead: '#2DD4BF', k: 1,
                   rungs: ['#22C55E', '#3B82F6', '#F59E0B', '#F43F5E'] },
          light: { strand: ['#0D9488', '#0F766E'], bead: '#0F766E', k: 1.7,
                   rungs: ['#15803D', '#1D4ED8', '#B45309', '#BE123C'] },
        };
        const OPACITY = 0.4, SPEED = 0.8, DENSITY = 0.9, ANGLE = 20 * Math.PI / 180;

        let W, H, DPR = Math.min(window.devicePixelRatio || 1, 2), helices = [];

        function build() {
          helices = [];
          const cols = Math.max(2, Math.round(window.innerWidth / 300 * DENSITY));
          for (let i = 0; i < cols; i++) {
            helices.push({
              x: (i + 0.5) / cols,
              amp: 22 + Math.random() * 16,
              pitch: 30 + Math.random() * 12,
              speed: 0.3 + Math.random() * 0.4,
              phase: Math.random() * Math.PI * 2,
              dir: Math.random() < 0.5 ? 1 : -1,
              nt: (Math.random() * 4) | 0,
            });
          }
        }

        function resize() {
          DPR = Math.min(window.devicePixelRatio || 1, 2);
          W = canvas.width = Math.floor(window.innerWidth * DPR);
          H = canvas.height = Math.floor(window.innerHeight * DPR);
          canvas.style.width = window.innerWidth + 'px';
          canvas.style.height = window.innerHeight + 'px';
          build();
        }

        const isLight = () => document.documentElement.getAttribute('data-theme') === 'light';

        function drawHelix(h, t) {
          const ux = Math.sin(ANGLE), uy = Math.cos(ANGLE);   // axis direction (tilted)
          const px = Math.cos(ANGLE), py = -Math.sin(ANGLE);  // perpendicular
          const cx = h.x * W, cy = H / 2;
          const amp = h.amp * DPR, pitch = h.pitch * DPR, step = 6 * DPR;
          const len = Math.hypot(W, H) + 4 * step;            // crosses viewport at any tilt
          const spin = t * h.speed * h.dir;
          const A = [], B = [];
          for (let s = -len / 2; s <= len / 2; s += step) {
            const a = s / pitch + h.phase + spin;
            const bx = cx + ux * s, by = cy + uy * s;
            const dA = (Math.cos(a) + 1) / 2;                 // 0 back .. 1 front
            const oA = Math.sin(a) * amp, oB = Math.sin(a + Math.PI) * amp;
            A.push({ x: bx + px * oA, y: by + py * oA, d: dA });
            B.push({ x: bx + px * oB, y: by + py * oB, d: 1 - dA });
          }
          const P = PALETTE[isLight() ? 'light' : 'dark'];

          for (let i = 0; i < A.length; i += 3) {             // base-pair rungs
            const depth = Math.max(A[i].d, B[i].d);
            ctx.strokeStyle = P.rungs[(h.nt + ((i / 3) | 0)) % 4];
            ctx.globalAlpha = (0.10 + 0.32 * depth) * OPACITY * P.k;
            ctx.lineWidth = (0.6 + depth * 1.1) * DPR;
            ctx.beginPath(); ctx.moveTo(A[i].x, A[i].y); ctx.lineTo(B[i].x, B[i].y); ctx.stroke();
          }
          for (const [pts, col] of [[A, P.strand[0]], [B, P.strand[1]]]) { // backbones
            ctx.strokeStyle = col; ctx.globalAlpha = 0.30 * OPACITY * P.k; ctx.lineWidth = 1.4 * DPR;
            ctx.beginPath();
            pts.forEach((p, i) => i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y));
            ctx.stroke();
          }
          for (let i = 0; i < A.length; i += 3) {             // backbone beads
            for (const p of [A[i], B[i]]) {
              ctx.globalAlpha = (0.18 + 0.6 * p.d) * OPACITY * P.k;
              ctx.fillStyle = P.bead;
              ctx.beginPath(); ctx.arc(p.x, p.y, (0.8 + p.d * 1.8) * DPR, 0, Math.PI * 2); ctx.fill();
            }
          }
        }

        function frame(t) {
          ctx.clearRect(0, 0, W, H);
          for (const h of helices) drawHelix(h, t);
          ctx.globalAlpha = 1;
        }
        function loop(now) { frame(now * 0.001 * SPEED); requestAnimationFrame(loop); }

        resize();
        window.addEventListener('resize', () => { resize(); if (reduce) frame(0); });
        if (reduce) frame(0); else requestAnimationFrame(loop);
      })();
    </script>
  </body>
</html>
